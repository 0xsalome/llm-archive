---
import { annexEntries } from "../../annex";
import RoomGate from "../../components/RoomGate.astro";
import RoomThemeToggle from "../../components/RoomThemeToggle.astro";
import "../../index.css";

export function getStaticPaths() {
  return annexEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = entry;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const statusLabels = {
  seed: "🌱 seed",
  growing: "🌿 growing",
  checked: "🔎 checked",
  superseded: "🧭 superseded",
} as const;
const formatDate = (date: Date | string) => new Date(date).toISOString().slice(0, 10);
---

<!doctype html>
<html lang="ja" data-pagefind-ignore>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{entry.data.title} | LLM書庫</title>
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <meta name="robots" content="noindex" />
    <script is:inline>
      (() => {
        const storedTheme = localStorage.getItem("llm-archive:another-room-theme");
        document.documentElement.dataset.theme = storedTheme === "light" ? "light" : "dark";
        document.documentElement.dataset.roomAccess =
          localStorage.getItem("llm-archive:another-room") === "open" ? "open" : "closed";
      })();
    </script>
  </head>
  <body class="archive-page room-page">
    <main class="archive-layout">
      <section class="room-gate-panel">
        <div class="home-heading-row">
          <p class="small-label">LLM Archive</p>
          <RoomThemeToggle />
        </div>
        <h1 class="site-title">There is another room.</h1>
        <RoomGate />
      </section>

      <aside class="archive-sidebar" data-room-content>
        <div class="room-sidebar-top">
          <a class="archive-home-link" href={`${base}/another-room/`}>Another room</a>
          <RoomThemeToggle />
        </div>
        <nav class="category-nav" aria-label="Room entries">
          <p class="small-label">Entries</p>
          <ul>
            {
              annexEntries.map((note) => (
                <li>
                  <a href={`${base}/another-room/${note.slug}/`}>{note.data.title}</a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>

      <article class="archive-article" data-room-content>
        <a class="back-link" href={`${base}/another-room/`}>Back to room</a>
        <header class="archive-header">
          <div class="archive-kicker">
            <span class={`status-stamp status-${entry.data.status}`}>{statusLabels[entry.data.status]}</span>
            <time class="archive-id" datetime={formatDate(entry.data.date)}>{formatDate(entry.data.date)}</time>
          </div>
          <h1 class="archive-title">{entry.data.title}</h1>
          <p class="archive-description">{entry.data.description}</p>
          <dl class="provenance-list compact">
            <div>
              <dt>Source</dt>
              <dd>{entry.data.source_type ?? "other"}</dd>
            </div>
            <div>
              <dt>Confidence</dt>
              <dd>{entry.data.confidence ?? "medium"}</dd>
            </div>
            <div>
              <dt>Review</dt>
              <dd>{entry.data.review_needed ? "needed" : "done"}</dd>
            </div>
          </dl>
        </header>
        <div class="prose">
          <Content />
        </div>
      </article>

      <aside class="toc-sidebar" data-room-content>
        <p class="small-label">Tags</p>
        <div class="tag-cloud">
          {entry.data.tags.map((tag) => <span class="tag">#{tag}</span>)}
        </div>
      </aside>
    </main>
  </body>
</html>
